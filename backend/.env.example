# =================================================================
# LifeLine-Core Environment Configuration
# =================================================================
# Copy this file to backend/.env and populate with your actual keys.
# NEVER commit the actual .env file or hardcode credentials!
# =================================================================

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
DEBUG=false

# ── LLM Provider ─────────────────────────────────────────────────
# Options: "groq" (recommended for cloud) or "ollama" (local)
LLM_PROVIDER=groq

# ── Groq Cloud LLM (Required if LLM_PROVIDER=groq) ───────────────
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Ollama Local LLM (Required if LLM_PROVIDER=ollama) ───────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3
OLLAMA_NUM_GPU=99

# ── MongoDB Atlas / Local MongoDB ────────────────────────────────
# Connection string (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority)
# If empty, the system automatically uses the graceful in-memory development fallback.
MONGODB_URI=
MONGODB_DB_NAME=lifeline

# ── External AI & Speech Services ────────────────────────────────
# Sarvam AI API key for Indian language STT/TTS (https://sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# Deepgram fallback STT (optional)
DEEPGRAM_API_KEY=

# Gemini Vision API Key for emergency visual evidence analysis (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# STT Provider: "groq" (Whisper large-v3-turbo) or "sarvam" (saaras:v2.5)
STT_PROVIDER=groq

# ── RAG / ChromaDB Vector Store ──────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db_v2
CHROMA_COLLECTION=emergency_protocols
EMBEDDING_MODEL=mxbai-embed-large

# ── CORS ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173

# ── Voice Activity Detection (VAD) ──────────────────────────────
VAD_AGGRESSIVENESS=3
VAD_FRAME_DURATION_MS=30
VAD_PADDING_DURATION_MS=300
VAD_MIN_SPEECH_MS=500
VAD_ENERGY_THRESHOLD=500
